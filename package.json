{
  "name": "@energyweb/vcc-prover-mcp",
  "version": "1.0.1",
  "description": "Client-side zero-knowledge UltraHonk prover MCP server for Energy Web verified compute.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/energywebfoundation/vcc-prover-mcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vcc-prover-mcp": "./bin/vcc-prove-mcp.js",
    "vcc-prove-mcp": "./bin/vcc-prove-mcp.js",
    "vcc-prove": "./bin/vcc-prove.js",
    "vcc-verify": "./bin/vcc-verify.js",
    "vcc-audit": "./bin/vcc-audit.js"
  },
  "files": [
    "manifest.json",
    "bin/*.js",
    "dist",
    "artifacts",
    "vendor",
    "README.md",
    "USAGE.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/artifacts && cp artifacts/hasher.json dist/artifacts/",
    "start": "node bin/vcc-prove-mcp.js",
    "mcp": "node bin/vcc-prove-mcp.js",
    "pack:mcpb": "mcpb pack . dist/vcc-prover.mcpb",
    "test": "tsx test/prover.test.ts && tsx test/in-memory.test.ts",
    "test:inmem": "tsx test/in-memory.test.ts",
    "test:bin": "bash test/bin.test.sh",
    "crs:fetch": "bash scripts/fetch-crs.sh"
  },
  "dependencies": {
    "@aztec/bb.js": "0.58.0",
    "@noir-lang/acvm_js": "^0.52.0",
    "@noir-lang/noir_js": "^0.36.0",
    "@noir-lang/noirc_abi": "^0.36.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}